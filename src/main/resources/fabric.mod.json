{
  "schemaVersion": 1,
  "id": "autototem",
  "version": "${version}",
  "name": "Auto Totem",
  "description": "An essential utility mod that automatically swaps a Totem of Undying into your off-hand based on health or a customizable keybind.",
  "authors": [
    "Noty215"
  ],
  "contact": {
    "homepage": "https://modrinth.com/user/NotY215",
    "issues": "https://github.com/NotY215/AutoTotem/issues",
    "sources": "https://github.com/NotY215/AutoTotem"
  },
  "license": "MIT",
  "icon": "assets/autototem/icon.png",
  "environment": "client",
  "entrypoints": {
    "main": [
      "com.noty.auto.AutoTotem"
    ],
    "client": [
      "com.noty.auto.client.AutoTotemClient"
    ]
  },
  "mixins": [
  ],
  "depends": {
    "fabricloader": ">=0.19.0",
    "minecraft": "~26.1",
    "java": ">=25",
    "fabric-api": "*"
  }
